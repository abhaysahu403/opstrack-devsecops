# ---- Secrets / credentials - never commit these ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json
gcp-key.json
*-service-account*.json
kubeconfig

# ---- Go build artifacts ----
bin/
*.exe
*.test
*.out
coverage.out
coverage.html

# ---- Generated CI/CD reports (regenerated on every run) ----
reports/*
!reports/.gitkeep
opstrack-ci-reports.zip

# ---- IDE / OS ----
.vscode/
.idea/
*.swp
.DS_Store

# ---- Misc ----
*.log
tmp/
.cache/
