# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opstrack
DB_USER=opstrack
DB_PASSWORD=change-me-locally
DB_SSLMODE=disable

# ---- Server ----
SERVER_PORT=8080
APP_ENV=development

# ---- Migrations (optional override) ----
MIGRATIONS_DIR=migrations
